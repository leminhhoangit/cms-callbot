# ========================================================
# Cấu hình biến môi trường CMS Callbot
# ========================================================

# Cổng truy cập Web CMS (mặc định: 8780)
CMS_PORT=8780

# Cổng truy cập máy chủ iCC giả lập (mặc định: 8790)
MOCK_ICC_PORT=8790

# Cấu hình kết nối hệ thống huấn luyện Callbot iCC
# 'mock' dùng dịch vụ mock_icc đi kèm; khi có API thật đổi thành 'icc'
CMS_TRAIN_PROVIDER=mock
CMS_TRAIN_URL=http://mock-icc:8790
CMS_TRAIN_API_KEY=mock-key

# Thời gian tối đa cho 1 job train trước khi coi là timeout (giờ)
CMS_TRAIN_TIMEOUT_HOURS=2

# Bỏ kích hoạt luồng kiểm tra nền (nếu cần kiểm thử)
# CMS_NO_POLLER=1

